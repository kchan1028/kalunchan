{
  "name": "kalunchan.dev",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "gsap": "3.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.4",
    "web-vitals": "^5.3.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview --outDir build",
    "audit:seo": "python3 scripts/audit-seo.py",
    "audit:writing": "python3 scripts/audit-writing.py",
    "validate": "npm test && BUILD_DIR=.validate npm run build && BUILD_DIR=.validate npm run audit:seo && BUILD_DIR=.validate npm run audit:writing",
    "deploy": "bash scripts/deploy.sh",
    "headers": "node scripts/cloudflare-security-headers.mjs",
    "redirects": "node scripts/cloudflare-redirects.mjs",
    "events": "node scripts/cloudflare-events.mjs",
    "contact:dev": "node scripts/contact-dev-server.mjs",
    "contact:email-dns": "node scripts/contact-email-dns.mjs",
    "contact:deploy": "bash serverless/contact/deploy.sh",
    "test:contact": "node --test tests/contact.test.mjs",
    "test:events": "node --test tests/events.test.mjs",
    "metadata:update": "UPDATE_LASTMOD=1 BUILD_DIR=.validate npm run build",
    "test:unit": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:browser": "playwright test",
    "test": "npm run test:unit && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.3.6"
  },
  "type": "module"
}
