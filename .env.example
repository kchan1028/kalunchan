# Copy to .env (gitignored) and fill in. npm run deploy reads it.
# This example is committed: never put real values, especially the Cloudflare token, here.

# Bucket that serves kalunchan.dev (the S3 website origin behind Cloudflare).
DEPLOY_S3_BUCKET=

# AWS CLI profile with write access to that bucket. Required: the shell's
# AWS_PROFILE is ignored so a work profile can't be used by accident.
DEPLOY_AWS_PROFILE=

# Optional: region of the bucket.
DEPLOY_AWS_REGION=

# Optional but recommended: the deploy stops unless the profile is signed in to this account.
DEPLOY_AWS_ACCOUNT_ID=

# Set to true only once you've confirmed the bucket holds nothing but this site's
# build output. Then files that are no longer in build/ are deleted on each deploy.
DEPLOY_S3_DELETE=false

# Optional: days to keep old JS and CSS bundles after a deploy drops them, so pages still cached by Cloudflare or a
# browser keep their styles. Default 8 (Cloudflare's browser cache TTL). Use 0 once Cloudflare respects origin headers.
# Only applies when DEPLOY_S3_DELETE=true.
DEPLOY_ASSET_RETENTION_DAYS=8

# Optional: purge Cloudflare's cache after each deploy. Set both or neither.
# Zone ID: Cloudflare dashboard → kalunchan.dev → Overview (right sidebar).
# Token: My Profile → API Tokens → Create Token → Custom token with
#   Permissions: Zone · Cache Purge · Purge; Zone Resources: Include · Specific zone · kalunchan.dev
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Token with Zone · Transform Rules · Edit on kalunchan.dev, used by npm run deploy and npm run headers to set the
# security response headers (HSTS, CSP, nosniff, X-Frame-Options, Referrer-Policy). Falls back to CLOUDFLARE_API_TOKEN.
CLOUDFLARE_RULES_API_TOKEN=

# Optional: token with Zone · Single Redirect · Edit on kalunchan.dev, used only by npm run redirects to write the
# 301s in scripts/redirects.json. Falls back to CLOUDFLARE_RULES_API_TOKEN, then CLOUDFLARE_API_TOKEN.
CLOUDFLARE_REDIRECTS_API_TOKEN=

# Optional: click counts on /engineering-leadership/ (npm run events). Account ID: Cloudflare dashboard → Overview.
# Token permissions: Account · Workers Scripts · Edit, Account · Account Analytics · Read, and
# Zone · Workers Routes · Edit on kalunchan.dev. Falls back to CLOUDFLARE_API_TOKEN.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_API_TOKEN=

# ---------- Contact form (npm run contact:deploy) ----------
# Inbox that receives contact form messages. Never shown on the site.
CONTACT_TO=

# Sender address, on a domain set up by npm run contact:email-dns (e.g. website@kalunchan.dev).
# Defaults to CONTACT_TO.
CONTACT_FROM_ADDRESS=

# Optional: Cloudflare token with Zone · DNS · Edit on kalunchan.dev, used only by
# npm run contact:email-dns to publish the SES DKIM, MAIL FROM and DMARC records.
# Without it the script prints the records to add by hand. It's a secret: keep it in .env only.
CLOUDFLARE_DNS_API_TOKEN=

# Optional: profile and region for the Lambda and SES. The profile defaults to DEPLOY_AWS_PROFILE,
# the region to us-west-2. The account is checked against DEPLOY_AWS_ACCOUNT_ID when that is set.
CONTACT_AWS_PROFILE=
CONTACT_AWS_REGION=

# Optional: DynamoDB table (partition key pk, TTL on expiresAt) so rate limits hold across Lambda instances.
CONTACT_RATE_LIMIT_TABLE=

# Written by contact:deploy on its first run; keeps hashed visitor IPs unguessable.
# CONTACT_IP_HASH_SALT=
